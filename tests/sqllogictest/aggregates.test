query TT nosort
select city, group_concat(name) from people group by city order by city
----
Amsterdam Edsger
London Ada,Alan,Katherine
New York Grace,Barbara

query TT nosort
select city, group_concat(distinct city) from people group by city order by city
----
Amsterdam Amsterdam
London London
New York New York

query T nosort
select city from people group by city having count(*) > 1 order by city
----
London
New York

